# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins)
APPS_PASSWORD=change-moi-12-caracteres-minimum

# Dossier du NAS pour les données de Comptoir
COMPTOIR_DATA_DIR=/volume1/docker/comptoir

# Facultatif : clé d'API Mistral (relire une recette mal découpée, seulement sur un clic)
COMPTOIR_MISTRAL_CLE=

# « non » : Comptoir ne cherche pas l'origine des cocktails dans Wikidata (lecture seule)
COMPTOIR_RECHERCHE_WEB=oui

# Facultatif
# PORT_COMPTOIR=8092
# COMPTOIR_VERSION=0.1.0
