# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins)
MAISON_PASSWORD=change-moi-12-caracteres-minimum
# Jeton commun des applis maison : l'Anneau collecte chaque nuit les réglages de Comptoir (/externe/sauvegarde)
# et « Restaurer les réglages » les relit chez lui. Vide : la sauvegarde et la restauration sont fermées.
MAISON_JETON=change-moi-jeton-commun
# Clé de lecture de l'Anneau (contrat 3) : n'ouvre que les fiches « Connexion ». Vide : l'Anneau ne les lit pas.
ANNEAU_CLE=

# Dossier du NAS pour les données de Comptoir
COMPTOIR_DATA_DIR=/volume1/docker/comptoir

# Facultatif : clé d'API Mistral (relire une recette mal découpée, seulement sur un clic)
COMPTOIR_MISTRAL_CLE=

# La recherche d'origine dans Wikidata se règle dans Comptoir (Réglages), plus dans la stack.
# COMPTOIR_RECHERCHE_WEB n'est lue qu'une fois, au premier démarrage de la 0.6, pour reprendre la valeur.

# Facultatif
# PORT_COMPTOIR=8092
# COMPTOIR_VERSION=0.6.0
